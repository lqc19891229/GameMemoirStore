extends SceneTree
const State = preload("res://scripts/store_state.gd")
var checks: int = 0
var failed: Array[String] = []

func check(value: bool, message: String) -> void:
	checks += 1
	if not value:
		failed.append(message)
		push_error(message)

func _initialize() -> void:
	_run.call_deferred()

func _run() -> void:
	var client = load("res://scenes/store.tscn").instantiate()
	root.add_child(client)
	await process_frame
	client.download_timer.stop()
	check(client.route["kind"] == "home", "client opens storefront")
	check(client.available_games().size() == 6, "timeline exposes six starting titles")
	check(client.back_button.disabled, "back button disabled at history start")
	client.open_product("distant_signal")
	check(client.route["kind"] == "product", "product opens as full page")
	check(client.find_child("ProductAdd", true, false) != null, "product page has purchase action")
	check(client.recent_views.has("distant_signal"), "product visit records recent history")
	client.navigate({"kind": "wishlist"})
	client.go_history(-1)
	check(client.route["kind"] == "product" and client.route["id"] == "distant_signal", "back restores exact product route")
	client.go_history(1)
	check(client.route["kind"] == "wishlist", "forward restores wishlist route")
	client.go_history(-1)
	client.navigate({"kind": "search"})
	check(client.forward_button.disabled, "new navigation removes abandoned forward branch")
	var results: Array = client.search_games({"kind": "search", "query": "微光"})
	check(results.size() == 1 and results[0]["id"] == "distant_signal", "search matches Chinese studio and excludes unreleased title")
	check(client.search_games({"filter": "coming"}).size() == 6, "coming soon lists future titles")
	check(client.search_games({"genre": "生活模拟"}).size() == 2, "genre filter works")
	results = client.search_games({"sort": 1})
	var ascending: bool = true
	for i: int in range(1, results.size()):
		ascending = ascending and client.state.price(results[i - 1]["id"]) <= client.state.price(results[i]["id"])
	check(ascending, "price sorting uses discounted price")
	client.state.toggle_wishlist("distant_signal")
	client.state.toggle_wishlist("mist_valley")
	client.state.toggle_wishlist("midnight_castle")
	client.state.prioritize_wish("midnight_castle")
	check(client.state.wishlist[0] == "midnight_castle", "wishlist prioritization preserves explicit order")
	client.navigate({"kind": "wishlist"})
	check(client.get_node("%PageContent").get_child_count() == 1, "wishlist renders its own page")
	client.open_product("midnight_castle")
	check(client.find_child("ProductAdd", true, false) == null, "unreleased product has no enabled purchase action")
	client.state.add_to_cart("midnight_castle")
	check(client.state.cart.is_empty(), "business layer rejects unreleased purchase")
	client.open_product("distant_signal")
	client.find_child("ProductAdd", true, false).pressed.emit()
	check(client.state.cart == ["distant_signal"], "product action adds correct game")
	client.add_cart("mist_valley")
	client.add_cart("iron_frontier")
	client.navigate({"kind": "cart"})
	check(client.find_child("ContinuePurchase", true, false).disabled, "cart disables checkout when over budget")
	var rejected: Dictionary = client.state.checkout()
	check(not rejected["ok"] and client.state.wallet == 160 and client.state.owned.is_empty(), "over-budget order has no partial effects")
	client.state.remove_from_cart("iron_frontier")
	client.refresh_client()
	client.find_child("ContinuePurchase", true, false).pressed.emit()
	check(client.route["kind"] == "checkout", "cart continues to review page")
	client.find_child("ConfirmPurchase", true, false).pressed.emit()
	check(client.route["kind"] == "receipt", "confirmed order opens receipt")
	check(client.state.wallet == 56 and client.state.owned.size() == 2, "order charges exact total")
	check(not client.state.wishlist.has("distant_signal") and not client.state.wishlist.has("mist_valley"), "purchased games leave wishlist")
	check(client.state.cart.is_empty(), "completed order clears cart")
	client.state.add_to_cart("distant_signal")
	check(client.state.cart.is_empty(), "owned game cannot be repurchased")
	client.navigate({"kind": "library", "id": "distant_signal"})
	check(not client.get_node("%StoreNavigation").visible, "library has independent client layout")
	check(client.find_child("LibraryItem_distant_signal", true, false) != null, "library sidebar lists owned game")
	client.find_child("LibraryAction", true, false).pressed.emit()
	check(client.state.downloads.has("distant_signal"), "install action starts simulated download")
	client.state.start_install("distant_signal")
	check(client.state.downloads.size() == 1, "duplicate install does not duplicate downloads")
	client.state.start_install("iron_frontier")
	check(not client.state.downloads.has("iron_frontier"), "unowned game cannot be installed")
	client._download_tick()
	check(int(client.state.downloads["distant_signal"]) == 8, "download tick updates progress")
	for i: int in range(12): client._download_tick()
	check(client.state.installed.has("distant_signal") and client.state.downloads.is_empty(), "completed install updates installed list")
	check(client.find_child("LibraryAction", true, false).text == "开始游戏", "installed game switches library action to play")
	client.running_game_id = "distant_signal"
	client.finish_session()
	check(client.state.play_minutes["distant_signal"] == 45 and client.state.activity.size() == 1, "ending session records play time and activity")
	client.finish_session()
	check(client.state.play_minutes["distant_signal"] == 45, "session cannot be recorded twice")
	check(not client.state.record_play("iron_frontier"), "unowned title cannot gain play records")
	client.state.toggle_list("distant_signal", "favorites")
	client.navigate({"kind": "library", "collection": 2})
	check(client.find_child("LibraryItem_distant_signal", true, false) != null and client.find_child("LibraryItem_mist_valley", true, false) == null, "favorites collection filters sidebar")
	client.state.toggle_list("iron_frontier", "ignored")
	client.start_discovery()
	check(client.queue_ids.size() == 3, "discovery excludes owned and ignored games")
	check(not client.queue_ids.has("iron_frontier") and not client.queue_ids.has("distant_signal"), "discovery respects exclusions")
	client.find_child("QueueNext", true, false).pressed.emit()
	check(int(client.route["index"]) == 1, "queue next action advances route")
	while int(client.route["index"]) < client.queue_ids.size(): client.next_queue()
	check(client.find_child("QueueNext", true, false) == null, "finished queue has a completion page")
	client.state.uninstall("distant_signal")
	check(not client.state.installed.has("distant_signal") and client.state.owned.has("distant_signal"), "uninstall keeps purchase ownership")
	check(client.state.play_minutes["distant_signal"] == 45, "uninstall preserves play history")
	client.state.start_install("distant_signal")
	client.state.start_install("mist_valley")
	client.state.tick_downloads(50)
	check(client.state.downloads["distant_signal"] == 50 and client.state.downloads["mist_valley"] == 0, "download queue advances only the first task")
	client.state.tick_downloads(50)
	client.state.tick_downloads(8)
	check(client.state.installed.has("distant_signal") and client.state.downloads["mist_valley"] == 8, "next task starts after queue head completes")
	client.state.uninstall("mist_valley")
	var hidden: Array = client.search_games({"hide_owned": true})
	check(hidden.size() == 4, "search hide-owned preference works")
	for kind: String in ["downloads", "profile", "community", "search", "home"]:
		client.navigate({"kind": kind})
		check(client.get_node("%PageContent").get_child_count() == 1, "render page: " + kind)
	var store = State.new()
	store.save_path = "user://memoir_client_compatibility_test.json"
	var file := FileAccess.open(store.save_path, FileAccess.WRITE)
	file.store_string(JSON.stringify({"version": 1, "wallet": 55, "month": 1, "owned": ["distant_signal"], "wishlist": ["midnight_castle"], "cart": ["mist_valley"], "history": [{"id": "distant_signal", "price": 66, "month": 0}]}))
	file.close()
	store.load_state()
	check(store.wallet == 55 and store.owned.has("distant_signal") and store.cart.has("mist_valley"), "version 1 saves migrate without losing purchases")
	check(store.installed.is_empty() and store.play_minutes.is_empty(), "new state fields get safe migration defaults")
	store.start_install("distant_signal")
	store.tick_downloads(100)
	store.record_play("distant_signal")
	store.toggle_list("distant_signal", "favorites")
	check(store.save_state(), "version 2 save succeeds")
	var copy = State.new()
	copy.save_path = store.save_path
	copy.load_state()
	check(copy.installed == store.installed and copy.favorites == store.favorites and copy.play_minutes == store.play_minutes and copy.activity == store.activity, "version 2 preserves installation, favorite, play record and activity")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(store.save_path))
	await process_frame
	client.queue_free()
	await process_frame
	print("CLIENT_CHECKS: %d passed / %d checks" % [checks - failed.size(), checks])
	quit(0 if failed.is_empty() else 1)
